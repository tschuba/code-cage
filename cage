#!/bin/sh
set -e
SCRIPT="$(readlink "$0" || echo "$0")"
CAGE_DIR="$(cd "$(dirname "$SCRIPT")" && pwd)"
case "$1" in
    -h|--help)
        [ -f "$HOME/.cage/config" ] && . "$HOME/.cage/config"
        _harnesses=$(ls -d "$CAGE_DIR"/*-kit 2>/dev/null | xargs -I{} basename {} -kit | tr '\n' ' ')
        cat <<USAGE
Usage: cage [<harness>] [-- <agent-args>...]
       cage use <harness>

Run an agent in a sandbox (default harness: ${default_harness:-claude}).

Available harnesses: ${_harnesses% }

Commands:
  use <harness>   Set the default harness (persisted to ~/.cage/config)

Arguments passed after "--" are forwarded to the agent.
USAGE
        exit 0 ;;
esac
if [ "$1" = "use" ]; then
    case "$2" in
        ''|-*) echo "usage: cage use <harness>" >&2; exit 1 ;;
    esac
    mkdir -p "$HOME/.cage"
    echo "default_harness=$2" > "$HOME/.cage/config"
    echo "Default harness set to: $2"
    exit 0
fi
case "$1" in
    ''|-*) [ -f "$HOME/.cage/config" ] && . "$HOME/.cage/config" ;;  # ponytail: sources user-owned file, same threat model as .zshrc
esac
case "$1" in
    -*) AGENT="${default_harness:-claude}" ;;
    *)  AGENT="${1:-${default_harness:-claude}}"; shift 2>/dev/null || true ;;
esac
KIT="$CAGE_DIR/${AGENT}-kit"
KIT_KIND="$(grep '^kind:' "$KIT/spec.yaml" 2>/dev/null | awk '{print $2}')"
NAME="${AGENT}-$(basename "$(pwd)" | tr -cs 'a-zA-Z0-9.' '-' | sed 's/-$//')-$$"

# Start clipboard daemon if not already running
if ! pgrep -qf cage-clipd 2>/dev/null; then
    "$HOME/.cage/venv/bin/python3" "$CAGE_DIR/cage-clipd" >/dev/null 2>&1 &
fi

# Start host app launch daemon if not already running
if ! pgrep -qf cage-opend 2>/dev/null; then
    mkdir -p "$HOME/.cage/open"
    "$CAGE_DIR/cage-opend" >/dev/null 2>&1 &
fi

rm -rf "$HOME/.cage/host-tmpdir"
mkdir -p "$HOME/.cage/host-tmpdir"
echo "$TMPDIR" > "$HOME/.cage/host-tmpdir/path"
mkdir -p "$HOME/.cage/tmpdir"
mkdir -p "$HOME/.cage/claude-projects"
mkdir -p "$HOME/.cage/pi-sessions"

printf '\033]0;⬡ cage:%s\007' "$AGENT"
wezterm cli set-tab-title "⬡ cage:$AGENT" 2>/dev/null || true
AGENT_MOUNTS=""
case "$AGENT" in
  pi) AGENT_MOUNTS="$HOME/.pi/agent:ro $HOME/.pi/skills:ro"  # ponytail: unquoted in exec so shell word-splits the two mounts; paths must not contain spaces
      set -- --session-dir "$HOME/.cage/pi-sessions" "$@" ;;
esac
SBX_MOUNTS=". $HOME/.claude:ro $HOME/Downloads:ro $HOME/Documents:ro $HOME/Desktop:ro $TMPDIR:ro $HOME/.cage/host-tmpdir:ro $HOME/.cage/tmpdir $HOME/.cage/open $HOME/.cage/claude-projects $HOME/.cage/pi-sessions"
if [ "$AGENT" = "pi" ] && [ "$KIT_KIND" = "agent" ]; then
  cp "$HOME/.pi/agent/auth.json" "$HOME/.cage/tmpdir/pi-auth.json"
  sbx run "$AGENT" --kit "$KIT" --name "$NAME" $SBX_MOUNTS $AGENT_MOUNTS -- "$@"  # ponytail: no exec so we can write auth back after session
  [ "$HOME/.cage/tmpdir/pi-auth.json" -nt "$HOME/.pi/agent/auth.json" ] && cp "$HOME/.cage/tmpdir/pi-auth.json" "$HOME/.pi/agent/auth.json"
else
  [ "$KIT_KIND" != "agent" ] && set -- --dangerously-skip-permissions "$@"
  exec sbx run "$AGENT" --kit "$KIT" --name "$NAME" $SBX_MOUNTS $AGENT_MOUNTS -- "$@"
fi
