#!/usr/bin/env python3
# cage-opend — watch ~/.cage/open/ for host open requests from cage sessions
import json
import os
import subprocess
import time

OPEN_DIR = os.path.expanduser("~/.cage/open")
os.makedirs(OPEN_DIR, exist_ok=True)


def handle_request(path):
    try:
        with open(path) as f:
            req = json.load(f)
    except Exception:
        try:
            os.remove(path)
        except OSError:
            pass
        return
    args = req.get("args")
    # ponytail: compat for old {"type":"open-vscode","path":"..."} format
    if not args and req.get("type") == "open-vscode" and req.get("path"):
        args = ["-a", "Visual Studio Code", req["path"]]
    if args and isinstance(args, list):
        try:
            subprocess.Popen(["/usr/bin/open"] + args)
        except OSError:
            pass
    try:
        os.remove(path)
    except OSError:
        pass


def main():
    while True:
        try:
            for entry in os.scandir(OPEN_DIR):
                if entry.name.endswith(".json") and entry.is_file():
                    handle_request(entry.path)
        except OSError:
            pass
        time.sleep(0.3)


if __name__ == "__main__":
    main()
