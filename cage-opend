#!/usr/bin/env python3
# cage-opend — watch ~/.cage/open/ for VS Code launch requests from cage sessions
import json
import os
import subprocess
import time

OPEN_DIR = os.path.expanduser("~/.cage/open")
os.makedirs(OPEN_DIR, exist_ok=True)

LAUNCHERS = {
    "open-vscode": ["open", "-a", "Visual Studio Code"],
}


def handle_request(path):
    try:
        with open(path) as f:
            req = json.load(f)
    except Exception:
        try:
            os.remove(path)
        except OSError:
            pass
        return
    req_type = req.get("type", "")
    req_path = req.get("path", "")
    cmd = LAUNCHERS.get(req_type)
    if cmd and req_path:
        try:
            subprocess.Popen(cmd + [req_path])
        except OSError:
            pass
    try:
        os.remove(path)
    except OSError:
        pass


def main():
    while True:
        try:
            for entry in os.scandir(OPEN_DIR):
                if entry.name.endswith(".json") and entry.is_file():
                    handle_request(entry.path)
        except OSError:
            pass
        time.sleep(0.3)


if __name__ == "__main__":
    main()
